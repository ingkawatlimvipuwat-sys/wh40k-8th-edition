        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">32&quot;</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 12D6</characteristic>
        <characteristic name="S" typeId="59b1-319e-ec13-d466">5</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">0</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">1</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">NLOS. On a wound roll of 6+, inflicts 1 mortal wound in addition to normal damage.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-0557-0019" name="PGM Glide" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 2</characteristic>
        <characteristic name="S" typeId="59b1-319e-ec13-d466">14</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">-2</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">D6</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">NLOS. On a wound roll of 6+, inflicts D3 mortal wounds in addition to normal damage.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-2446-001a" name="Drake Chain Gun" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">32&quot;</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 4</characteristic>
        <characteristic name="S" typeId="59b1-319e-ec13-d466">6</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">-1</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">2</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">-</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-4335-001b" name="EW Pods" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">100&quot;</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 1</characteristic>
        <characteristic name="S" typeId="59b1-319e-ec13-d466">-</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">-</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">-</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">NLOS. On a hit, the target suffers the Electronic Warfare effect.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-6224-001c" name="Quetzal Battery" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">120&quot;</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 3D3</characteristic>
        <characteristic name="S" typeId="59b1-319e-ec13-d466">10</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">-2</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">D6</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">NLOS. On a wound roll of 6+, inflicts D3 mortal wounds in addition to normal damage.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-8113-001d" name="Quetzal Gatling" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 8</characteristic>
        <characteristic name="S" typeId="59b1-319e-ec13-d466">5</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">-1</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">1</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">-</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-a002-001e" name="Quetzal EW Array" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">100&quot;</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 4</characteristic>
        <characteristic name="S" typeId="59b1-319e-ec13-d466">-</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">-</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">-</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">NLOS. On a hit, the target suffers the Electronic Warfare effect.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-bef1-001f" name="Gestalt" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Reroll leadership tests for this unit and take the best result.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-dde0-0020" name="Noosphere" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit projects Shadow in the Warp to a range of 16&quot;. Multiple instances stack, to a maximum of -4 to psychic tests.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-fccf-0021" name="Operations Support" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Roll once on the Operations Support table each turn for each full detachment in your army.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-1bbe-0022" name="Combined Arms" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit does not suffer the penalty to hit rolls for firing Heavy weapons after making a normal move.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-3aad-0023" name="Stealth" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Subtract 1 from hit rolls against this unit. This ability is lost if the unit Advances.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-599c-0024" name="Chromatophore" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Subtract 1 from hit rolls against this unit while it is stationary. Stacks with Stealth.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-788b-0025" name="Active Camo" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit may Infiltrate. Its Stealth ability continues to apply while Advancing and in melee.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-977a-0026" name="Point Defense" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit may make 1 S3 D1 shot against a unit that can FLY within 12&quot;. Friendly units within 6&quot; of this model may reroll successful hit rolls made against them by missile weapons.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-b669-0027" name="Sensor Uplink" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units firing NLOS weapons may reroll the number of shots against enemy units within 20&quot; of this unit.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-d558-0028" name="NLOS" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This weapon may be fired using the rules for Indirect Fire, and may benefit from Sensor Uplink.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-f447-0029" name="Semi-Autonomous AI" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Roll twice for this unit's shooting and movement dice and take the worst result. This is negated while the unit is within 12&quot; of a friendly GESTALT unit.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-1336-002a" name="Electronic Warfare" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A unit hit by this weapon loses the benefit of all non-psychic support abilities (markerlights, orders and similar) until the end of the turn.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-3225-002b" name="Cohesion" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this unit is within 8&quot; of another friendly unit with the GESTALT keyword, add 1 to its Leadership.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-5114-002c" name="Wyrmscale Mk.III" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Grants a 4+ armour save and the Stealth ability.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-7003-002d" name="Cataphract Suit Mk.IV" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Grants a 3+ armour save, +1 Strength, +4&quot; Move, and the Stealth and Active Camo abilities.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-8ef2-002e" name="Combat Management AI" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of each turn choose one: reroll failed wound rolls for one weapon type this turn; or this unit may Advance after shooting.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-ade1-002f" name="GSR Post" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this unit is stationary, place a targeting token on an enemy unit within line of sight. A friendly unit with NLOS weapons may consume the token to gain +1 to hit against that unit.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-ccd0-0030" name="Resupply" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly GESTALT INFANTRY units within 3&quot; gain a 6+ Feel No Pain and may reroll hit rolls of 1 in the Shooting phase.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-ebbf-0031" name="UGV Attachment" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit may attach to or detach from a friendly unit at the start of any Movement phase, following the rules for character attachment.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-0aae-0032" name="Swarm Deployment" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of each Shooting phase choose one mode: Recon (place a targeting token as per GSR Post), FPV (use the Drone Hive weapon profile), or Interceptor (gain Point Defense until your next turn).</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-299d-0033" name="Scout" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the first battle round, before the first turn begins, this unit may make a normal move of up to 9&quot;.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-488c-0034" name="Intercept" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When an enemy unit is set up on the battlefield as reinforcements within 24&quot; of this model, this unit may immediately shoot at that unit as if it were the Shooting phase.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-677b-0035" name="Shoot and Scoot" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">After shooting, this unit may make a normal move of up to 7&quot;, provided it does not end within 1&quot; of any enemy model.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-866a-0036" name="Transform" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of any Movement phase declare Fighter or Walker mode. Fighter: use 20&quot; Move and may fire all weapons. Walker: use 6&quot; Move, may fire only Drake Chain Guns, loses FLY, gains Objective Secured, and may charge.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-a559-0037" name="Dimorph Repair" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn roll 1D3. On a 3, restore 1 lost wound to a friendly DIMORPH unit within 12&quot;.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-c448-0038" name="Mobile Logistics Hub" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Reroll failed reserve rolls for friendly units.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-e337-0039" name="Gestalt Commander" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any model with the GESTALT keyword may be designated as the Gestalt Commander at the start of any friendly turn. While designated, that model's unit gains the HQ battlefield role. On the turn of designation, the detachment the HQ belongs to may not roll on the Operations Support table. The Gestalt Commander does not award victory points for Slay the Warlord.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-0226-003a" name="Quetzal Intel Core" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All friendly Sensor Uplink ranges become 28&quot;.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-2115-003b" name="Pair Doctrine" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Dimorphs always operate as a pair. One radiates while the other runs silent and shoots.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-4004-003c" name="HLUV Transport" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
      <characteristics>
        <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">Up to 8 INFANTRY models and/or UGV units, in any combination of DESANT LIVGARDET, AKRITAI LIVGARDET, CATAPHRACT and UGV units.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-5ef3-003d" name="Viper Transport" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
      <characteristics>
        <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">1 AKRITAI LIVGARDET squad (4 models).</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-7de2-003e" name="Venom Transport" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
      <characteristics>
        <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">Up to 6 INFANTRY models. Expanded to 8 INFANTRY models plus 1 UGV unit with the Transport pod.</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-266c-0054" name="Desant Livgardet" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
      <characteristics>
        <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
        <characteristic name="WS" typeId="e7f0-1278-0250-df0c">3+</characteristic>
        <characteristic name="BS" typeId="381b-eb28-74c3-df5f">3+</characteristic>
        <characteristic name="S" typeId="2218-aa3c-265f-2939">3</characteristic>
        <characteristic name="T" typeId="9c9f-9774-a358-3a39">3</characteristic>
        <characteristic name="W" typeId="f330-5e6e-4110-0978">1</characteristic>
        <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">1</characteristic>
        <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">7</characteristic>
        <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">4+</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-455b-0055" name="Akritai Livgardet" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
      <characteristics>
        <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
        <characteristic name="WS" typeId="e7f0-1278-0250-df0c">3+</characteristic>
        <characteristic name="BS" typeId="381b-eb28-74c3-df5f">3+</characteristic>
        <characteristic name="S" typeId="2218-aa3c-265f-2939">3</characteristic>
        <characteristic name="T" typeId="9c9f-9774-a358-3a39">3</characteristic>
        <characteristic name="W" typeId="f330-5e6e-4110-0978">1</characteristic>
        <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">1</characteristic>
        <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">7</characteristic>
        <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">4+</characteristic>
      </characteristics>
    </profile>
    <profile id="9e57-0000-644a-0056" name="Cataphract Node" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
      <characteristics>
        <characteristic name="M" typeId="0bdf-a96e-9e38-7779">10&quot;</characteristic>
        <characteristic name="WS" typeId="e7f0-1278-0250-df0c">3+</characteristic>
        <characteristic name="BS" typeId="381b-eb28-74c3-df5f">3+</characteristic>
        <characteristic name="S" typeId="2218-aa3c-265f-2939">4</characteristic>
        <characteristic name="T" typeId="9c9f-9774-a358-3a39">3</characteristic>
        <characteristic name="W" typeId="f330-5e6e-4110-0978">2</characteristic>
